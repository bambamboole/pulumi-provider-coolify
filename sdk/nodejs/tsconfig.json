{
    "compilerOptions": {
        "outDir": ".",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": [
            "node"
        ],
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "application.ts",
        "config/index.ts",
        "config/vars.ts",
        "database.ts",
        "deployment.ts",
        "index.ts",
        "privateKey.ts",
        "project.ts",
        "provider.ts",
        "s3storage.ts",
        "server.ts",
        "utilities.ts"
    ]
}
