{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "application.ts",
        "config/index.ts",
        "config/vars.ts",
        "database.ts",
        "databaseBackup.ts",
        "deployment.ts",
        "getStorage.ts",
        "gitHubApp.ts",
        "index.ts",
        "privateKey.ts",
        "project.ts",
        "provider.ts",
        "s3storage.ts",
        "scheduledTask.ts",
        "server.ts",
        "service.ts",
        "storage.ts",
        "types/enums/index.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts",
        "volumeBackup.ts"
    ]
}
